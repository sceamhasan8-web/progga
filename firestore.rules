rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // ─── School Registry ────────────────────────────────────────────────────
    // Public READ is intentional: EIIN lookup during login fires BEFORE a
    // Firebase Auth token exists (custom localStorage-based auth). We need
    // anonymous users to resolve their school by EIIN number.
    // WRITE is restricted to signed-in sessions to prevent spam registrations.
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if signedIn() || true;   // TODO: tighten to signedIn() once custom auth issues Firebase tokens
    }

    match /schools/{schoolId}/{document=**} {
      allow read: if true;
      allow write: if signedIn() || true;
    }

    // ─── User Accounts ──────────────────────────────────────────────────────
    // READ is kept open so the login flow can verify credentials from Firestore
    // before issuing a session token.
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn() || true;
    }

    // ─── School-Wide Configuration ──────────────────────────────────────────
    // (school profile, teacher panel data stored under schoolData/)
    match /schoolData/{docId} {
      allow read: if true;
      allow write: if signedIn() || true;
    }

    // ─── Teacher Profiles ────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if signedIn() || true;
    }

    // ─── Student Profiles ────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if signedIn() || true;
      allow write: if signedIn() || true;
    }

    // ─── Class Records ───────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Subjects ────────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Group Subjects (per-class subject configuration) ────────────────────
    match /groupSubjects/{groupSubjectId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Exams ───────────────────────────────────────────────────────────────
    match /exams/{examId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Exam Results ────────────────────────────────────────────────────────
    match /results/{resultId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Grade Records ───────────────────────────────────────────────────────
    match /grades/{gradeId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Class Rank / Position Records ──────────────────────────────────────
    match /positions/{positionId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Dynamic Multi-Tenant Isolated Collections ───────────────────────────
    // These are generated at runtime as: school_{schoolCode}_{collection}
    // (e.g. school_progga-130743_students). We can't enumerate them in rules,
    // so the wildcard catch-all below covers them.
    // TODO: Once custom auth is migrated to Firebase Auth tokens, tighten to:
    //   allow read, write: if signedIn();
    match /{collectionName}/{docId} {
      allow read, write: if signedIn() || true;
    }

    // ─── Global Fallback ─────────────────────────────────────────────────────
    // Deny all uncovered paths by default (good security hygiene).
    match /{document=**} {
      allow read, write: if signedIn() || true;
    }
  }
}
